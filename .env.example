DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

NEXTAUTH_SECRET="replace-with-a-secure-secret"
NEXTAUTH_URL="http://localhost:3000"

# open allows public self-serve signup. invite/request return controlled non-500 flows.
# Preview/dev default to open when unset; production defaults to request when unset.
AUTH_SIGNUP_MODE="open"

EMAIL_FROM="noreply@upgradefor.com"
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""

# R006-B placeholder: Google OAuth requires account-linking schema before enabling.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
